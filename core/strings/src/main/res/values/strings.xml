<resources>
    <string name="setup_catalog">Catalog</string>
    <string name="setup_tmdb_intro">Franklix gets artwork, synopses, seasons and age ratings from TMDB. The key is free.</string>
    <string name="setup_tmdb_step_account">Create a free account at themoviedb.org (or sign in).</string>
    <string name="setup_tmdb_step_api">In your profile: Settings → API → request a key for personal use.</string>
    <string name="setup_tmdb_step_copy">Copy the “API Key” (32 letters and numbers, not the long token) and type it here.</string>
    <string name="setup_debrid_service">Debrid service</string>
    <string name="setup_debrid_intro">The debrid service is what plays movies at full speed. Choose yours with ◀ ▶ and connect it.</string>
    <string name="setup_debrid_torrentio"> It works through Torrentio, like in Stremio.</string>
    <string name="setup_extra_subtitles">Extra subtitles</string>
    <string name="setup_subdl_intro">Optional. With a SubDL key you get more external subtitles. OpenSubtitles and Podnapisi already work without a key.</string>
    <string name="setup_subdl_step_account">Create a free account at subdl.com.</string>
    <string name="setup_subdl_step_api">Go to your panel → API and generate a key.</string>
    <string name="setup_subdl_step_copy">Copy it and type it here. If you don\'t want it, press “Skip”.</string>
    <string name="setup_rd_step_account">Sign in at real-debrid.com (Premium required).</string>
    <string name="setup_rd_step_token">Open the token page: real-debrid.com/apitoken</string>
    <string name="setup_rd_step_copy">Copy the token and type it here.</string>
    <string name="setup_torbox_step_account">Sign in at torbox.app.</string>
    <string name="setup_torbox_step_settings">Open Settings and find your API key.</string>
    <string name="setup_premiumize_step_account">Sign in at premiumize.me.</string>
    <string name="setup_premiumize_step_settings">Open “Account” and find the API Key.</string>
    <string name="setup_alldebrid_step_account">Scan the QR and sign in at alldebrid.com.</string>
    <string name="setup_alldebrid_step_settings">Approve Franklix; the key is saved automatically.</string>
    <string name="setup_alldebrid_step_manual">You can also copy an API key and type it here.</string>
    <string name="setup_debrid_link_step_account">Sign in at debrid-link.com.</string>
    <string name="setup_debrid_link_step_settings">Open the API key page (debrid-link.com/webapp/apikey).</string>
    <string name="setup_offcloud_step_account">Sign in at offcloud.com.</string>
    <string name="setup_offcloud_step_settings">Open “Account” and find your API key.</string>
    <string name="setup_copy_key">Copy it and type it here.</string>
    <string name="setup_step_counter">STEP %1$d OF 4</string>
